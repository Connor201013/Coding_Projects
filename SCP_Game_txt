    private static boolean isMovementCommand(String input) {
        return input.startsWith("go ")
                || input.equals("north")
                || input.equals("south")
                || input.equals("east")
                || input.equals("west");
    }
    // Combat
    private static void executeSpyTurn() {
        if (!spyAlive) {
            return;
        }
        System.out.println("\n⚡ [ENEMY TURN] Hostile agent fires standard weapon cycles!");
        int dodgeChance = Math.min(95, 15 + cautionLevel * 4);
        if (RAND.nextInt(100) < dodgeChance) {
            System.out.println("🛡️ Structural shield frames absorbed the rounds.");
        } else {
            int damage = 15 + RAND.nextInt(15);
            playerHp -= damage;
            System.out.println("🔴 Critical hit! Damage sustained: -" + damage + " HP.");
            if (!isO5()) {
                panicLevel += 2;
            }
        }
        clampPlayerMetrics();
    }
