    // SCP-096
    private static void roamScp096() {
        // Site 20: SCP-096 stays in its containment room
        // until the player triggers it.
        if (trappedInSite20 && !scp096Enraged) {
            scp096Room = "SCP-096 Containment Chamber";
            return;
        }
        if (scp096Enraged) {
            scp096Room = currentRoom;
            return;
        }
        String[] rooms = {
                "Sector 4 Hallway",
                "The Armory",
                "Research Laboratory",
                "Shattered Observation Room",
                "Sub-Level Maintenance Tunnel",
                "SCP-173 Containment Chamber"
        };
        if (RAND.nextInt(100) < 40) {
            scp096Room = rooms[RAND.nextInt(rooms.length)];
        }
    }
    private static void handleScp096Encounter(Scanner scan) {
        if (!currentRoom.equals(scp096Room)) {
            return;
        }
        System.out.println("\n⚠️⚠️⚠️ WARNING ⚠️⚠️⚠️");
        if (scp096Enraged) {
            System.out.println("🔴 SCP-096 IS ENRAGED! Screaming fills your location.");
            return;
        }
        if (isO5()) {
            System.out.println("👑 SCP-096 is huddled nearby. You know better than to look at its face.");
            cautionLevel += 4;
            return;
        }
        if (trappedInSite20) {
            System.out.println("A pale figure is sitting in the corner of the containment room.");
            System.out.println("SCP-096 is covering its face and quietly sobbing.");
            System.out.println("A warning is painted across the observation glass:");
            System.out.println("DO NOT LOOK AT SCP-096'S FACE.");
        } else {
            System.out.println("An emaciated creature is sobbing in the corner, holding its face.");
        }
        System.out.println("CRITICAL: Choose gaze trajectory ('look down' / 'look up')");
        System.out.print("Your choice > ");
        String gaze = scan.nextLine().toLowerCase().trim();

        if (gaze.contains("up") || gaze.contains("look at")) {
            scp096Enraged = true;
            if (!isO5()) {
                panicLevel += 8;
            }
            System.out.println("\n😱 SCP-096's jaw hyperextends.");
            System.out.println("Its weeping morphs into an absolute shriek!");
        } else {
            cautionLevel += 4;
            System.out.println("\n🛡️ You keep your eyes on the floor.");
            System.out.println("SCP-096 continues to sob quietly.");
        }
    }
