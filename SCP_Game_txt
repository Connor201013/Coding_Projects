    // SCP-173
    private static int blinkTimer = 3;
    private static final Random RAND = new Random();
    public static void main(String[] args) {
        try (Scanner scan = new Scanner(System.in)) {
            boolean runningApplication = true;
           while (runningApplication) {
                resetRunState();
                printTitle();
                chooseCharacterClass(scan);
                printOpening();

                while (!isGameOver) {
                    turnsTaken++;

                    if (!trappedInSite20 && currentRoom.equals("SCP-173 Containment Chamber") && blinkTimer <= 0) {
                        System.out.println("\n💀 [BLINK FAIL] Your eyes dried out. You blinked for a split second.");
                        System.out.println("The concrete statue closed the gap instantly. Your neck is snapped.");
                        playerHp = 0;
                        checkWinLossConditions(scan);
                        break;
                    }
                    displayRoomDescription();
                    handleScp096Encounter(scan);
                    if (isGameOver) {
                        break;
                    }
                    displayAvailableActions();
                    System.out.print("What do you want to do? > ");
                    String input = scan.nextLine().toLowerCase().trim();
                    processPlayerAction(input);
                    if (isGameOver) {
                        break;
                    }
                    if (!trappedInSite20 && currentRoom.equals("SCP-173 Containment Chamber") && !input.equals("blink")) {
                        blinkTimer--;
                        if (blinkTimer <= 0) {
                            System.out.println("\n💀 [BLINK FAIL] Your eyes dried out. The statue moves.");
                            playerHp = 0;
                            checkWinLossConditions(scan);
                            break;
                        }
                    }
                    if (currentRoom.equals("Research Laboratory") && spyAlive && !isGameOver) {
                        executeSpyTurn();
                    }
                    if (isGameOver) {
                        break;
                    }
                    if (currentRoom.equals(scp096Room) && scp096Enraged && !isGameOver) {
                        executeScp096Attack();
                    }
                    if (isGameOver) {
                        checkWinLossConditions(scan);
                        break;
                    }
                    roamScp096();
                    checkWinLossConditions(scan);
                }
                System.out.print("\nWould you like to restart application simulations? (yes/no) > ");
                String playAgain = scan.nextLine().toLowerCase().trim();
                if (!playAgain.equals("yes") && !playAgain.equals("y")) {
                    runningApplication = false;
                }
            }
            System.out.println("\nThank you for playing Site 19 SCP Foundation.");
        }
    }
