    // Safety
    private static void clampPlayerMetrics() {
        playerHp = Math.max(0, Math.min(playerHp, maxHp));
        panicLevel = Math.max(0, panicLevel);
        cautionLevel = Math.max(0, cautionLevel);
    }
    // Win / Loss
    private static void checkWinLossConditions(Scanner scan) {
        clampPlayerMetrics();
        if (playerHp <= 0) {
            System.out.println("\n💀 [GAME OVER] Core lifesign metrics hit terminal exhaustion.");
            isGameOver = true;
            return;
        }
        if (!trappedInSite20 && currentRoom.equals("SCP-173 Containment Chamber") && !inventory.contains("keycard")) {
            System.out.println("\n💀 [GAME OVER] Lockout failure. Anomaly terminal contact recorded.");
            isGameOver = true;
            return;
        }
        if (!currentRoom.equals("The Safe Zone")) {
            return;
        }
System.out.println("\n====================================================");
        System.out.println("🎉 BOUNDARY AREA REACHED! RUN METRICS LOGGED. 🎉");
        System.out.println("====================================================");
        if (isO5()) {
            handleO5Ending(scan);
            isGameOver = true;
            return;
        }
        System.out.println("Escape logged safely. Spent actions pool: " + turnsTaken);
        if (turnsTaken < 15 && !o5ClassUnlocked && !trappedInSite20) {
            o5ClassUnlocked = true;
