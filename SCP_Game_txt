    private static void processPlayerAction(String input) {
        if (currentRoom.equals("Research Laboratory") && spyAlive && isMovementCommand(input)) {
            // UNARMED SYSTEM INTEGRATION: Check if they are fighting bare-handed first SOFTLOCK FIX ON SPY AMBUSH
            if (!inventory.contains("sidearm")) {
                System.out.println("\n🚨 NO WEAPON EQUIPPED! As you try to rush past, you are forced into hand-to-hand combat!");
                int desperationDamage = 10 + RAND.nextInt(10) + (panicLevel / 2);
                spyHp -= desperationDamage;
                System.out.println("👊 You lunge forward blindly! You punch the spy squarely for " + desperationDamage + " damage!");
                if (!isO5()) {
                    panicLevel += isDClass() ? 2 : 4;
                }
                if (spyHp <= 0) {
                    spyHp = 0;
                    spyAlive = false;
                    System.out.println("💀 Against all odds, you broke their guard and neutralized the agent with your bare fists!");
                    System.out.println("The path is clear. You can now move freely next turn.");
                } else {
                    System.out.println("⚠️ The spy staggers but recovers! They maintain their blockade line.");
                }
            } else {
                // If they DO have a gun, it displays your original pinned down message instead
                System.out.println("❌ Escape blocked! The enemy has pinned you down.");
                if (!isO5()) {
                    panicLevel += isDClass() ? 1 : 2;
                }
            }
            return; 
        }
        switch (input) {
            case "help", "h", "commands" -> displayHelpMenu();
            case "blink" -> {
                if (!trappedInSite20 && currentRoom.equals("SCP-173 Containment Chamber")) {
                    blinkTimer = 3;
                    System.out.println("👁️ You blink deliberately. Visual target lock stabilized.");
                } else {
                    System.out.println("❌ Blinking serves no functional defensive role here.");
                }
            }
            case "shoot", "fire" -> shoot();
            case "take cover", "cover" -> {
                System.out.println("🛡️ Hard defensive positions established.");
                cautionLevel += 3;

                if (!isO5() && panicLevel > 0) {
                    panicLevel = Math.max(0, panicLevel - 2);
                }
            }
            case "use stimulant", "use medkit" -> useStimulant();
            case "north", "go north" -> moveNorth();
            case "east", "go east" -> moveEast();
            case "west", "go west" -> moveWest();
            case "south", "go south" -> moveSouth();
            case "take keycard", "grab keycard", "keycard" -> takeKeycard();
            case "take stimulant", "grab stimulant", "stimulant" -> takeStimulant();
            case "search debris", "search", "explore" -> search();
            default -> {
                System.out.println("❌ Command unrecognized.");
                if (!isO5()) {
                    panicLevel += isDClass() ? 0 : 1;
                }
            }
        }
        clampPlayerMetrics();
    }
    private static void shoot() {
        if (!inventory.contains("sidearm")) {
            System.out.println("❌ No weapon platform equipped.");
            if (!isO5()) {
                panicLevel += 2;
            }
            return;
        }
        int adjustedPanic = Math.max(0, Math.min(panicLevel, 12));
        int accuracyChance = Math.min(95, 45 + adjustedPanic * 4);
        if (RAND.nextInt(100) < accuracyChance) {
            int damage = 20 + RAND.nextInt(15);
            if (currentRoom.equals(scp096Room)) {
                System.out.println("💥 Sparks fly off SCP-096. It shrieks louder!");
                scp096Enraged = true;
                return;
            }
            if (currentRoom.equals("Research Laboratory") && spyAlive) {
                spyHp -= damage;
                System.out.println("💥 Hit confirmed! You dealt " + damage + " damage!");
                if (spyHp <= 0) {
                    spyHp = 0;
                    spyAlive = false;
                    System.out.println("💀 The hostile agent has been neutralized!");
                }
                return;
            }
            System.out.println("💥 Shot fired, but there is no valid target.");
        } else {
            System.out.println("💨 Round missed target boundaries.");
            if (!isO5()) {
                panicLevel++;
            }
        }
    }
    private static void useStimulant() {
        if (inventory.contains("stimulant")) {
            inventory.remove("stimulant");
            playerHp = Math.min(maxHp, playerHp + 45);
            panicLevel = 0;
            System.out.println("💉 Injector discharged. Biometric indices restored.");
        } else {
            System.out.println("❌ Resource absent.");
        }
    }
