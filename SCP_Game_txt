    private static boolean trappedInSite20 = false;
    private static String currentRoom = "Sector 4 Hallway";
    private static final ArrayList<String> inventory = new ArrayList<>();
    private static boolean isGameOver = false;
    private static int panicLevel = 0;
    private static int cautionLevel = 0;
    private static int turnsTaken = 0;
    // Player
    private static String playerClass = "";
